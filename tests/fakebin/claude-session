class Exit(Exception):
    """Leave with ``code``; ``envelope`` (if any) is printed as the error envelope."""

    def __init__(self, status: int, message: str = "", **envelope: object) -> None:
        super().__init__(message)
        self.status = status
        self.message = message
        self.envelope = envelope


class Signalled(Exception):
    def __init__(self, signum: int) -> None:
        super().__init__(signum)
        self.signum = signum


# Output and log


def emit(obj: object) -> None:
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def log_line(record: dict[str, object]) -> None:
    path = os.environ.get("FAKE_CS_LOG")
    if not path:
        return
    data = (json.dumps(record) + "\n").encode()
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    try:
        os.write(fd, data)  # one O_APPEND write: concurrent calls never interleave
    finally:
        os.close(fd)


def now() -> datetime:
    return datetime.now(UTC)


def stamp(moment: datetime | None = None) -> str:
    return (moment or now()).strftime("%Y-%m-%dT%H:%M:%S.%fZ")


# Argument grammar (mirrors claude-session's argparse tree, allow_abbrev=False)


class UsageError(Exception):
    pass


class Parser(argparse.ArgumentParser):
    def error(self, message: str) -> None:  # type: ignore[override]
        raise UsageError(message)


def add_globals(p: argparse.ArgumentParser) -> None:
    p.add_argument("--json", action="store_true")
    p.add_argument("--config")
    p.add_argument("--verbose", action="store_true")
    p.add_argument("--quiet", action="store_true")
    p.add_argument("--yes", action="store_true")


def add_launch_flags(p: argparse.ArgumentParser) -> None:
    p.add_argument("--kind")
    p.add_argument("--mode", choices=("interactive", "headless"))
    p.add_argument("--skill")
    p.add_argument("--prompt-file")
    p.add_argument("--input-file", action="append")
    p.add_argument("--plugin-dir", action="append")
    p.add_argument("--repo")
    p.add_argument("--label", action="append")
    p.add_argument("--hook", action="append")
    p.add_argument("--hook-timeout", action="append")
    p.add_argument("--cwd")
    p.add_argument("--timeout")
    p.add_argument("--max-turns", type=int)
    p.add_argument("--model")
    p.add_argument("--permission-profile")
    p.add_argument("--sandbox", choices=("required", "preferred", "off"))
    p.add_argument("--setting-sources")
    p.add_argument("--reads-third-party", action="store_true", default=None)
    p.add_argument("--auto-exit", action=argparse.BooleanOptionalAction)
    p.add_argument("--implicit-done", action=argparse.BooleanOptionalAction)
    p.add_argument("--tools", action="extend", nargs="+")
    p.add_argument("--env-allow", action="append")
    p.add_argument("--env-allowlist-only", action="append")
    p.add_argument("--outcome-file")
    p.add_argument("--actor")
    p.add_argument("--decision-id", action="append")
    p.add_argument("--dry-run", action="store_true")


def build_parser() -> argparse.ArgumentParser:
    parser = Parser(prog="claude-session", allow_abbrev=False)
    parser.add_argument("--version", action="store_true")
    commands = parser.add_subparsers(dest="command", required=True)

    def leaf(name: str) -> argparse.ArgumentParser:
        p = commands.add_parser(name, allow_abbrev=False)
        add_globals(p)
        return p

    p = leaf("exec")
    add_launch_flags(p)
    p.add_argument("--session-id")
    p.add_argument("--run", type=int)
    p = leaf("start")
    add_launch_flags(p)
    p.add_argument("--fork", action="store_true")
    p.add_argument("--reset", action="append")
    p.add_argument("--allow-tainted", action="store_true")
    p.add_argument("--override-escalation", action="store_true")
    p.add_argument("--resume")
    p = leaf("stop")
    p.add_argument("id")
    p.add_argument("--grace")
    p.add_argument("--actor")
    p.add_argument("--decision-id", action="append")
    p.add_argument("--dry-run", action="store_true")
    p = leaf("status")
    p.add_argument("id")
    p.add_argument("--run", type=int)
    p = leaf("list")
    p.add_argument("--label", action="append")
    p.add_argument("--state", action="append")
    p.add_argument("--kind")
    p.add_argument("--launch-kind")
    p.add_argument("--run-kind")
    p.add_argument("--mode", choices=("interactive", "headless"))
    p.add_argument("--needs-input", action="store_true")
    p.add_argument("--pending", action="store_true")
    p.add_argument("--repo")
    p.add_argument("--since")
    p.add_argument("--limit", type=int)
    p.add_argument("--forked-from")
    p.add_argument("--report-status", action="append")
    p.add_argument("--live", action="store_true")
    p.add_argument("--tainted", action="store_true")
    p = leaf("forget")
    p.add_argument("id", nargs="?")
    p.add_argument("--older-than")
    p.add_argument("--state", action="append")
    p.add_argument("--kind")
    p.add_argument("--label", action="append")
    p.add_argument("--purge", action="store_true")
    p.add_argument("--actor")
    p.add_argument("--decision-id", action="append")
    p.add_argument("--dry-run", action="store_true")
    return parser


def seconds_of(text: str, flag: str) -> float:
    if not DURATION.match(text):
        raise UsageError(f"{flag}: invalid duration {text!r}")
    for suffix, factor in (("ms", 0.001), ("s", 1), ("m", 60), ("h", 3600), ("d", 86400)):
        if text.endswith(suffix) and not text[-1].isdigit():
            return float(text[: -len(suffix)]) * factor
    return float(text)


# State (one JSON file per session, guarded by one flock)


def state_dir() -> str:
    path = os.environ.get("FAKE_CS_STATE")
    if not path:
        raise Exit(1, "FAKE_CS_STATE is not set", code="internal")
    return path


@contextlib.contextmanager
def locked():  # type: ignore[no-untyped-def]
    root = state_dir()
    os.makedirs(os.path.join(root, "sessions"), exist_ok=True)
    fd = os.open(os.path.join(root, "lock"), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)  # closing the descriptor releases the lock


def session_path(session_id: str) -> str:
    return os.path.join(state_dir(), "sessions", session_id + ".json")


def load(session_id: str) -> dict:
    with open(session_path(session_id), encoding="utf-8") as handle:
        return json.load(handle)


def save(rec: dict) -> None:
    rec["updated_at"] = stamp()
    path = session_path(rec["id"])
    tmp = path + f".tmp{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as handle:
        json.dump(rec, handle)
    os.replace(tmp, path)


def all_ids() -> list[str]:
    folder = os.path.join(state_dir(), "sessions")
    if not os.path.isdir(folder):
        return []
    return sorted(
        n[:-5] for n in os.listdir(folder) if SESSION_ID.fullmatch(n[:-5]) and n.endswith(".json")
    )


def resolve(text: str) -> dict:
    """Session id input: case-insensitive, ``cs-`` optional, a unique prefix of 4+ characters."""
    key = text.lower()
    body = key[3:] if key.startswith("cs-") else key
    if len(body) < 4:
        raise UsageError(f"session id too short: {text!r}")
    matches = [i for i in all_ids() if i[3:].startswith(body) and not load(i)["forgotten"]]
    if not matches:
        raise Exit(10, f"unknown session: {'cs-' + body}", code="not_found")
    if len(matches) > 1:
        raise Exit(21, f"ambiguous session id {text!r}", code="ambiguous", matches=matches)
    return load(matches[0])


def new_id() -> str:
    while True:
        body = base64.b32encode(secrets.token_bytes(5)).decode().lower()
        if not os.path.exists(session_path("cs-" + body)):
            return "cs-" + body


def proc_start(pid: int) -> str | None:
    try:
        with open(f"/proc/{pid}/stat", encoding="utf-8") as handle:
            text = handle.read()
    except OSError:
        return None
    return text.rsplit(")", 1)[1].split()[19]  # field 22: start time, after the last ")"


def proc_alive(pid: int, start: str | None) -> bool:
    """Alive means: exists, not a zombie, and (where /proc says) the same process start."""
    try:
        with open(f"/proc/{pid}/stat", encoding="utf-8") as handle:
            text = handle.read()
    except OSError:
        if os.path.isdir("/proc/self"):
            return False
        try:
            os.kill(pid, 0)  # no /proc (macOS): existence only
        except OSError:
            return False
        return True
    fields = text.rsplit(")", 1)[1].split()
    return fields[0] != "Z" and (start is None or fields[19] == start)


def add_event(rec: dict, to_state: str, cause: str, final: bool = False) -> None:
    events = rec["events"]
    events.append(
        {
            "event_id": len(events) + 1,
            "event_ts": stamp(),
            "run": rec["run"],
            "from_state": rec["state"],
            "to_state": to_state,
            "from_activity": rec["activity"],
            "to_activity": "working" if to_state == "working" else None,
            "needs_input_reason": None,
            "cause": cause,
            "final": final,
            "delivered": True,
        }
    )
    rec["state"] = to_state
    rec["activity"] = "working" if to_state == "working" else None


def finalize(
    rec: dict,
    outcome: str | None,
    end_reason: str,
    exit_code: int,
    report: dict | None,
    cause: str,
    phase: str = "session",
    message: str | None = None,
    state: str | None = None,
) -> None:
    """Make the run final (the caller holds the lock and saves)."""
    final_state = state or (
        {
            "done": "exited",
            "blocked": "exited",
            "needs-input": "exited",
            "failed": "exited",
            "not-started": "not-started",
        }.get(outcome or "", outcome or "exited")
    )
    rec.update(
        outcome=outcome,
        end_reason=end_reason,
        exit_code=exit_code,
        report=report,
        phase=phase,
        message=message,
        ended_at=stamp(),
        pending=False,
        expires_at=None,
    )
    add_event(rec, final_state, cause, final=True)


def liveness(rec: dict) -> dict:
    """A run whose wrapper died without finalizing it is lost (claude-session's liveness check)."""
    pid = rec["wrapper_pid"]
    if rec["ended_at"] is None and not rec["pending"] and pid is not None:
        if not proc_alive(pid, rec["wrapper_start"]):
            finalize(rec, "lost", "lost", 17, None, "liveness")
            save(rec)
    elif rec["pending"] and rec["ended_at"] is None and stamp() >= rec["expires_at"]:
        finalize(
            rec,
            "not-started",
            "never_adopted",
            12,
            None,
            "liveness",
            phase="launch",
            state="not-started",
        )
        save(rec)
    return rec


# Records, outcome objects, artifacts


def new_record(args: argparse.Namespace) -> dict:
    kind = args.kind or "implement"
    mode = args.mode or "interactive"
    labels = sorted({f"kind={kind}", *(args.label or [])})
    sandbox = args.sandbox or ("required" if kind in THIRD_PARTY_KINDS else "off")
    warnings = []
    if kind in THIRD_PARTY_KINDS and sandbox != "required":
        warnings.append(
            f"sandbox_lowered: third-party-reading run with sandbox '{sandbox}' (from flag); "
            "the baseline is 'required'"
        )
        if sandbox == "off":
            warnings.append(
                "third-party-reading run without a sandbox: only the evadable permission "
                "rules isolate it"
            )
    profile = args.permission_profile or "review"
    if "/" in profile or profile.endswith((".json", ".yaml", ".yml")):
        try:
            with open(profile, "rb") as handle:
                digest = hashlib.sha256(handle.read()).hexdigest()
        except OSError:
            digest = hashlib.sha256(profile.encode()).hexdigest()
        profile = "file:" + digest[:12]
    created = stamp()
    third = kind in THIRD_PARTY_KINDS
    return {
        "id": new_id(),
        "created_at": created,
        "updated_at": created,
        "kind": kind,
        "mode": mode,
        "labels": labels,
        "repo": args.repo,
        "skill": args.skill,
        "model": args.model,
        "sandbox": sandbox,
        "permission_profile": profile,
        "reads_third_party": third,
        "tainted": third,
        "actor": args.actor,
        "decision_ids": list(args.decision_id or []),
        "prompt": None,
        "inputs": [],
        "run": 1,
        "pending": True,
        "expires_at": stamp(now() + timedelta(minutes=10)),
        "forgotten": False,
        "forgotten_at": None,
        "wrapper_pid": None,
        "wrapper_start": None,
        "started_at": None,
        "stop_requested_at": None,
        "recorded_by_stop": False,
        "state": None,
        "activity": None,
        "phase": "launch",
        "outcome": None,
        "end_reason": None,
        "exit_code": None,
        "ended_at": None,
        "message": None,
        "report": None,
        "warnings": warnings,
        "events": [],
    }


def outcome_object(rec: dict) -> dict:
    session = rec["phase"] == "session"
    return {
        "csession_id": rec["id"],
        "run": rec["run"],
        "forked_from": None,
        "claude_session_id": CLAUDE_SESSION_UUID if session else None,
        "phase": rec["phase"],
        "outcome": rec["outcome"],
        "end_reason": rec["end_reason"],
        "exit_code": rec["exit_code"],
        "state": rec["state"],
        "report": rec["report"],
        "session_started_at": rec["started_at"] if session else None,
        "cost_usd": 0.005 if session else None,
        "num_turns": 3 if session else None,
        "message": rec["message"],
        "warnings": rec["warnings"],
    }


def write_outcome_file(path: str | None, obj: dict) -> None:
    if not path:
        return
    tmp = f"{path}.tmp{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as handle:
        json.dump(obj, handle)
    os.replace(tmp, path)


def find_nonce(rec: dict) -> str:
    forced = os.environ.get("FAKE_CS_NONCE")
    if forced:
        return forced
    text = ""
    if rec["prompt"]:
        with open(rec["prompt"], encoding="utf-8", errors="replace") as handle:
            text = handle.read()
    found = re.search(r"nonce\W{0,40}?([0-9a-f]{32})\b", text, re.IGNORECASE) or re.search(
        r"\b([0-9a-f]{32})\b", text
    )
    return found.group(1).lower() if found else "0" * 32


def artifact_bytes(kind: str, rec: dict) -> bytes:
    nonce = find_nonce(rec)
    if kind == "implicit":
        return b"fake result text\n"
    if kind == "garbage":
        return b"Unknown skill: the fake could not find the requested skill.\n"
    verdict: dict = {
        "schema_version": 1,
        "nonce": nonce,
        "decision": os.environ.get("FAKE_CS_DECISION", "allow"),
        "confidence": json.loads(os.environ.get("FAKE_CS_CONFIDENCE", "0.95")),
        "reasons": json.loads(os.environ.get("FAKE_CS_REASONS", '["fake reason"]')),
    }
    if kind == "nonce_mismatch":
        verdict["nonce"] = ("f" if nonce[0] != "f" else "e") * 32
    elif kind == "wrong_schema":
        verdict.update(schema_version=2, decision="maybe", confidence=1.5, extra=True)
    return (json.dumps(verdict, indent=2) + "\n").encode()


def freeze_artifact(rec: dict, name: str, data: bytes) -> dict:
    folder = os.path.join(
        state_dir(),
        "private",
        rec["id"],
        "runs",
        str(rec["run"]),
        "artifact",
        str(FROZEN_ARTIFACT_SEQ),
    )
    os.makedirs(folder, exist_ok=True)
    path = os.path.join(folder, name)
    with open(path, "wb") as handle:
        handle.write(data)
    os.chmod(path, 0o444)
    return {
        "name": name,
        "path": path,
        "sha256": hashlib.sha256(data).hexdigest(),
        "size": len(data),
    }


def build_report(rec: dict, status: str, artifact_kind: str | None) -> dict:
    implicit = artifact_kind == "implicit"
    artifact = None
    if artifact_kind:
        name = "result.md" if implicit else ARTIFACT_NAME
        artifact = freeze_artifact(rec, name, artifact_bytes(artifact_kind, rec))
    return {
        "status": status,
        "implicit": implicit,
        "summary": None if implicit else f"fake {status} summary",
        "reason": None if status in ("done",) else f"fake {status} reason",
        "artifact": artifact,
        "reported_at": stamp(),
    }


# Hangs


def hang(ignore_term: bool) -> None:
    """Stay until a signal arrives (or ``FAKE_CS_HANG_MAX``), so a leaked process ends itself."""
    if ignore_term:
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
    limit = time.monotonic() + float(os.environ.get("FAKE_CS_HANG_MAX", "120"))
    while time.monotonic() < limit:
        time.sleep(0.05)


def behavior(cmd: str) -> str | None:
    value = os.environ.get(f"FAKE_CS_BEHAVIOR_{cmd.upper()}")
    if not value:
        return None
    if value.split(":")[0] not in ("fail", *BEHAVIORS):
        raise Exit(1, f"unknown FAKE_CS_BEHAVIOR_{cmd.upper()} value {value!r}", code="internal")
    return value


def apply_behavior(cmd: str, value: str, allocated: bool = False) -> None:
    """Behaviors that replace the command's whole output."""
    if value.startswith("fail"):
        code = int(value.split(":")[1]) if ":" in value else 12
        names = {1: "internal", 2: "usage", 10: "not_found", 12: "failed"}
        raise Exit(code, f"fake {cmd} failure", code=names.get(code, "failed"))
    if value in ("hang", "hang_ignore_term"):
        hang(value == "hang_ignore_term")
        raise Exit(1, f"fake {cmd} hang ended", code="internal")
    if value == "garbage":
        sys.stdout.write('{"csession_id": "cs-')
        sys.stdout.flush()
        raise Exit(0)
    if value == "json_wrong":
        emit([])
        raise Exit(0)
    if value == "empty":
        raise Exit(0)


# Commands


def check_launch_flags(args: argparse.Namespace) -> None:
    if not args.json:
        raise UsageError("start requires --json")
    if args.kind and not KIND_NAME.match(args.kind):
        raise UsageError(f"invalid kind name {args.kind!r}")
    if args.skill and not SKILL_NAME.match(args.skill):
        raise UsageError(f"invalid skill name {args.skill!r}")
    for label in args.label or []:
        if not LABEL.match(label):
            raise UsageError(f"invalid label {label!r}")
    if args.timeout and args.timeout != "none" and seconds_of(args.timeout, "--timeout") <= 0:
        raise UsageError("--timeout must be positive (use 'none')")
    for name in [*(args.env_allow or []), *(n for n in args.env_allowlist_only or [] if n != "")]:
        if not ENV_NAME.match(name):
            raise UsageError(f"invalid environment variable name {name!r}")
    if args.setting_sources is not None:
        for part in filter(None, args.setting_sources.split(",")):
            if part not in ("user", "project", "local"):
                raise UsageError(f"invalid setting source {part!r}")
    if (args.mode or "interactive") == "headless" and not args.skill and not args.prompt_file:
        raise UsageError("a headless new session needs a skill or a prompt")
    if (args.mode or "interactive") != "headless":
        raise UsageError("the fake supports headless sessions only")
    for path in [args.prompt_file, *(args.input_file or [])]:
        if path and not os.path.isfile(path):
            raise UsageError(f"not a readable file: {path}")
    names = [os.path.basename(p) for p in args.input_file or []]
    if len(set(names)) != len(names) or not all(ARTIFACT_FILE.match(n) for n in names):
        raise UsageError("input file basenames must be unique artifact names")
    for flag in ("fork", "reset", "allow_tainted", "override_escalation", "resume"):
        if getattr(args, flag):
            raise UsageError("the fake does not implement resume or fork")


def stage_files(rec: dict, args: argparse.Namespace) -> None:
    folder = os.path.join(state_dir(), "private", rec["id"], "runs", "1", "staged")
    os.makedirs(folder, exist_ok=True)

    def copy(source: str) -> str:
        target = os.path.join(folder, os.path.basename(source))
        with open(source, "rb") as src, open(target, "wb") as dst:
            dst.write(src.read())
        return target

    if args.prompt_file:
        rec["prompt"] = copy(args.prompt_file)
    rec["inputs"] = [copy(p) for p in args.input_file or []]


def settings_failure(rec: dict) -> str | None:
    """A non-empty setting-sources list on a third-party-reading kind is refused at ``start``."""
    if rec["reads_third_party"] and rec.get("setting_sources"):
        return "unsafe_setting_sources"
    return None


def scenario_name() -> tuple[str, str]:
    """(scenario, phase at which a launch failure happens)."""
    raw = os.environ.get("FAKE_CS_SCENARIO", "valid")
    name, _, where = raw.partition("@")
    if (
        name not in SCENARIOS
        or where not in ("", "exec")
        or (where and name not in LAUNCH_FAILURES)
    ):
        raise Exit(1, f"unknown FAKE_CS_SCENARIO {raw!r}", code="internal")
    return name, where or "start"


def fail_launch(rec: dict, reason: str, sources: str = "user") -> None:
    message, hint = LAUNCH_FAILURES[reason]
    message = message.replace("got: user", f"got: {sources}")
    finalize(rec, "not-started", reason, 12, None, "launch", phase="launch", message=message)
    rec["message"] = message if hint is None else f"{message}; {hint}"


def cmd_start(args: argparse.Namespace) -> int:
    check_launch_flags(args)
    value = behavior("start")
    if value and value != "hang_after_allocate":
        apply_behavior("start", value)
    name, where = scenario_name()
    with locked():
        rec = new_record(args)
        rec["setting_sources"] = args.setting_sources or ""
        rec["input_names"] = [os.path.basename(p) for p in args.input_file or []]
        add_event(rec, "starting", "launch")
        stage_files(rec, args)
        os.makedirs(os.path.join(state_dir(), "sessions", rec["id"]), exist_ok=True)
        reason = settings_failure(rec)
        if reason is None and name in LAUNCH_FAILURES and where == "start":
            reason = name
        if reason is not None:
            sources = rec["setting_sources"] or "user"
            fail_launch(rec, reason, sources)
            message, hint = LAUNCH_FAILURES[reason]
            if reason == "unsafe_setting_sources":
                message = message.replace("got: user", f"got: {sources}")
            save(rec)
            write_outcome_file(args.outcome_file, outcome_object(rec))
            raise Exit(
                12,
                message,
                code="launch_failed",
                csession_id=rec["id"],
                run=1,
                end_reason=reason,
                hint=hint,
            )
        save(rec)
    if value == "hang_after_allocate":
        hang(False)
    emit(
        {
            "csession_id": rec["id"],
            "csession_dir": os.path.join(state_dir(), "sessions", rec["id"]),
            "argv": [
                os.path.abspath(sys.argv[0]),
                "exec",
                "--session-id",
                rec["id"],
                "--run",
                "1",
            ],
            "run": 1,
            "forked_from": None,
            "expires_at": rec["expires_at"],
            "required_env_names": [],
            "env_inherit": False,
            "warnings": rec["warnings"],
        }
    )
    return 0


ADOPTION_FLAGS = {
    "json",
    "dry_run",
    "outcome_file",
    "verbose",
    "quiet",
    "yes",
    "run",
    "session_id",
    "config",
}


def cmd_exec(args: argparse.Namespace) -> int:
    if not args.session_id:
        raise UsageError("the fake implements exec --session-id only")
    given = [
        k
        for k, v in vars(args).items()
        if k not in ADOPTION_FLAGS | {"command"} and v not in (None, False)
    ]
    if given:
        raise UsageError("exec --session-id accepts only --run, --json, --dry-run, --outcome-file")
    if args.run is not None and args.run < 1:
        raise UsageError("--run must be a positive integer")
    if args.dry_run:
        raise UsageError("the fake does not implement exec --dry-run")

    def on_signal(signum: int, _frame: object) -> None:
        raise Signalled(signum)

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, on_signal)
    try:
        return exec_adopted(args)
    except Signalled as caught:
        return exec_signalled(args, caught.signum)


def exec_signalled(args: argparse.Namespace, signum: int) -> int:
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    with locked():
        rec = resolve(args.session_id)
        if rec["ended_at"] is not None or rec["wrapper_pid"] != os.getpid():
            raise Exit(128 + signum)  # before adoption: ended by the signal, no output
        if rec["phase"] == "launch" and rec["started_at"] is None:
            reason = "canceled" if rec["stop_requested_at"] else "launch_interrupted"
            finalize(rec, "not-started", reason, 12, None, "stop", phase="launch")
        else:
            names = {signal.SIGTERM: "forwarded_term", signal.SIGHUP: "forwarded_hup"}
            reason = "stopped" if rec["stop_requested_at"] else names.get(signum, "forwarded_int")
            finalize(rec, "killed", reason, 15, None, "stop" if reason == "stopped" else "exit")
        save(rec)
    obj = outcome_object(rec)
    write_outcome_file(args.outcome_file, obj)
    if args.json:
        emit(obj)
    return rec["exit_code"]


def cmd_exec_refusal(rec: dict, args: argparse.Namespace) -> None:
    if args.run is not None and args.run != rec["run"]:
        raise Exit(20, f"cannot adopt {rec['id']}: expired", code="refused", reason="expired")
    if rec["ended_at"] is not None:
        raise Exit(20, f"cannot adopt {rec['id']}: expired", code="refused", reason="expired")
    if rec["wrapper_pid"] is not None:
        raise Exit(
            20,
            f"cannot adopt {rec['id']}: already_adopted",
            code="refused",
            reason="already_adopted",
        )
    if stamp() >= rec["expires_at"]:
        finalize(rec, "not-started", "never_adopted", 12, None, "liveness", phase="launch")
        save(rec)
        raise Exit(20, f"cannot adopt {rec['id']}: expired", code="refused", reason="expired")


def exec_adopted(args: argparse.Namespace) -> int:
    value = behavior("exec")
    with locked():
        rec = resolve(args.session_id)
        liveness(rec)
        cmd_exec_refusal(rec, args)
        rec["pending"] = False
        rec["wrapper_pid"] = os.getpid()
        rec["wrapper_start"] = proc_start(os.getpid())
        save(rec)
    if value and value not in ("hang", "hang_ignore_term"):
        apply_behavior("exec", value)  # may leave the run adopted but never finished
    name, where = scenario_name()
    if value in ("hang", "hang_ignore_term"):
        name = value
    if name in LAUNCH_FAILURES:
        with locked():
            rec = load(rec["id"])
            fail_launch(rec, name)
            save(rec)
        obj = outcome_object(rec)
        write_outcome_file(args.outcome_file, obj)
        if args.json:
            emit(obj)
        return 12
    with locked():
        rec = load(rec["id"])
        rec["phase"] = "session"
        rec["started_at"] = stamp()
        add_event(rec, "working", "SessionStart")
        save(rec)
    if name in HANG_SCENARIOS:
        hang(name == "hang_ignore_term")
        outcome, end_reason, code, status, art = ("timeout", "timeout", 16, None, None)
    else:
        delay = float(os.environ.get("FAKE_CS_DELAY_EXEC", "0"))
        end = time.monotonic() + delay
        while time.monotonic() < end:
            time.sleep(0.02)
        outcome, end_reason, code, status, art = SESSION_SCENARIOS[name]
        if name == "exit0_not_done":
            outcome = os.environ.get("FAKE_CS_EXIT0_OUTCOME", "blocked")
            status = outcome if outcome in ("blocked", "failed", "needs-input") else None
            art = None
    with locked():
        rec = load(rec["id"])
        report = build_report(rec, status, art) if status else None
        finalize(rec, outcome, end_reason, code, report, "exit")
        save(rec)
    obj = outcome_object(rec)
    write_outcome_file(args.outcome_file, obj)
    if args.json:
        emit(obj)
    return code


def status_object(rec: dict, run: int | None = None) -> dict:
    name = os.environ.get("FAKE_CS_SCENARIO", "valid").split("@")[0]
    report = rec["report"]
    if report and report["artifact"]:
        art = dict(report["artifact"])
        if name == "status_sha_mismatch":
            art["sha256"] = hashlib.sha256(b"tampered").hexdigest()
        elif name == "status_size_mismatch":
            art["size"] += 1
        elif name == "status_name_mismatch":
            art["name"] = "other.json"
        report = {**report, "artifact": art}
    live = rec["ended_at"] is None
    active = os.environ.get("FAKE_CS_SANDBOX_ACTIVE")
    sandbox_active = (active == "1") if active in ("0", "1") else rec["sandbox"] != "off"
    session_dir = os.path.join(state_dir(), "sessions", rec["id"])
    run_obj = {
        "run": rec["run"],
        "run_kind": rec["kind"],
        "reads_third_party": rec["reads_third_party"],
        "implicit_done": False,
        "mode": rec["mode"],
        "cwd": None if rec["started_at"] is None else os.path.join(session_dir, "work"),
        "repo": rec["repo"],
        "model": rec["model"],
        "skill": rec["skill"],
        "has_prompt": rec["prompt"] is not None,
        "sandbox": rec["sandbox"],
        "sandbox_active": sandbox_active and rec["started_at"] is not None,
        "permission_profile": rec["permission_profile"],
        "decision_ids": rec["decision_ids"],
        "input_files": rec["input_names"],
        "pending": rec["pending"],
        "expires_at": rec["expires_at"],
        "started_at": rec["started_at"],
        "session_started_at": rec["started_at"] if rec["phase"] == "session" else None,
        "ended_at": rec["ended_at"],
        "state": rec["state"],
        "phase": rec["phase"],
        "message": rec["message"],
        "stop_requested_at": rec["stop_requested_at"],
        "warnings": rec["warnings"],
        "state_since": rec["events"][-1]["event_ts"],
        "wrapper_pid": rec["wrapper_pid"],
        "wrapper_alive": bool(live and rec["wrapper_pid"]),
        "child_pid": None,
        "child_alive": False,
        "backstop_used": False,
        "report": report,
        "outcome": rec["outcome"],
        "end_reason": rec["end_reason"],
        "session_end_reason": None,
        "exit_code": rec["exit_code"],
        "result_path": os.path.join(
            state_dir(), "private", rec["id"], "runs", str(rec["run"]), "result.json"
        ),
        "cost_usd": 0.005 if rec["phase"] == "session" and not live else None,
        "num_turns": 3 if rec["phase"] == "session" and not live else None,
        "is_error": None,
    }
    session = list_item(rec)
    del session["phase"], session["last_outcome"], session["last_end_reason"]
    del session["exit_code"], session["report_status"]
    session.update(
        csession_dir=session_dir,
        claude_session_id=CLAUDE_SESSION_UUID if rec["phase"] == "session" else None,
        claude_session_ids=[],
        run=run_obj,
        runs=1,
        recent_events=rec["events"][-20:],
        warnings=[],
    )
    return session


def list_item(rec: dict) -> dict:
    live = rec["ended_at"] is None
    return {
        "csession_id": rec["id"],
        "created_at": rec["created_at"],
        "launch_kind": rec["kind"],
        "run_kind": rec["kind"],
        "state": rec["state"],
        "activity": rec["activity"],
        "needs_input_reason": None,
        "live": live,
        "tainted": rec["tainted"],
        "tainted_at": rec["created_at"] if rec["tainted"] else None,
        "tainted_by_run": 1 if rec["tainted"] else None,
        "forked_from": None,
        "labels": rec["labels"],
        "repo": rec["repo"],
        "mode": rec["mode"],
        "current_run": rec["run"],
        "pending": rec["pending"],
        "expires_at": rec["expires_at"],
        "updated_at": rec["updated_at"],
        "phase": rec["phase"],
        "last_outcome": rec["outcome"],
        "last_end_reason": rec["end_reason"],
        "exit_code": rec["exit_code"],
        "report_status": rec["report"]["status"] if rec["report"] else None,
    }


def cmd_status(args: argparse.Namespace) -> int:
    value = behavior("status")
    if value:
        apply_behavior("status", value)
    with locked():
        rec = liveness(resolve(args.id))
    if args.run not in (None, rec["run"]):
        raise Exit(10, f"unknown run: {args.run}", code="not_found")
    if args.json:
        emit(status_object(rec))
    else:
        sys.stdout.write(f"{rec['id']} {rec['state']}\n")
    return 0


def cmd_list(args: argparse.Namespace) -> int:
    value = behavior("list")
    if value:
        apply_behavior("list", value)
    if args.since or args.forked_from or args.tainted:
        raise UsageError("the fake does not implement list --since, --forked-from or --tainted")
    wanted = []
    for label in args.label or []:
        if not LABEL.match(label):
            raise UsageError(f"invalid label {label!r}")
        wanted.append(label)
    if args.limit is not None and args.limit < 1:
        raise UsageError("--limit must be at least 1")
    items = []
    with locked():
        for session_id in all_ids():
            rec = load(session_id)
            if rec["forgotten"]:
                continue
            rec = liveness(rec)
            item = list_item(rec)
            keep = (
                all(w in rec["labels"] for w in wanted)
                and (not args.state or rec["state"] in args.state)
                and (not args.kind or args.kind in (rec["kind"],))
                and (not args.launch_kind or rec["kind"] == args.launch_kind)
                and (not args.run_kind or rec["kind"] == args.run_kind)
                and (not args.mode or rec["mode"] == args.mode)
                and (not args.pending or rec["pending"])
                and (not args.live or item["live"])
                and (not args.needs_input or rec["state"] == "needs-input")
                and (not args.repo or rec["repo"] == args.repo)
                and (
                    not args.report_status
                    or (item["report_status"] or "none") in args.report_status
                )
            )
            if keep:
                items.append(item)
    items.sort(key=lambda i: i["updated_at"], reverse=True)
    if args.limit:
        items = items[: args.limit]
    if args.json:
        emit({"sessions": items})
    else:
        for item in items:
            sys.stdout.write(f"{item['csession_id']} {item['state']}\n")
    return 0


def cmd_forget(args: argparse.Namespace) -> int:
    value = behavior("forget")
    if value:
        apply_behavior("forget", value)
    bulk = args.older_than or args.state or args.kind or args.label
    if bulk and args.id:
        raise UsageError("bulk-only flags need no id")
    if bulk or not args.id:
        raise UsageError("the fake implements forget <id> only")
    with locked():
        rec = liveness(resolve(args.id))
        if rec["ended_at"] is None:
            raise Exit(
                20,
                f"{rec['id']} is live or has a pending run; end it with stop first",
                code="refused",
                reason="live",
            )
        when = now()
        entry = {
            "csession_id": rec["id"],
            "forgotten_at": stamp(when),
            "delete_after": stamp(when + timedelta(days=30)),
        }
        if args.purge:
            entry["purged"] = not args.dry_run
        if not args.dry_run:
            rec["forgotten"] = True
            rec["forgotten_at"] = entry["forgotten_at"]
            save(rec)
    if args.json:
        emit({"dry_run": args.dry_run, "forgotten": [entry], "skipped": []})
    return 0


def stop_object(rec: dict, **fields: object) -> dict:
    final = rec["ended_at"] is not None
    obj = {
        "csession_id": rec["id"],
        "run": rec["run"],
        "already_final": False,
        "canceled": False,
        "dry_run": False,
        "ended": final,
        "run_exit_code": rec["exit_code"],
        "signals": [],
        "state": rec["state"],
        "outcome": rec["outcome"],
        "end_reason": rec["end_reason"],
        "recorded_by_stop": False,
    }
    obj.update(fields)
    return obj


def send(pid: int, signum: int) -> None:
    with contextlib.suppress(OSError):
        os.kill(pid, signum)  # an exact, recorded and re-verified PID


def cmd_stop(args: argparse.Namespace) -> int:
    value = behavior("stop")
    if value:
        apply_behavior("stop", value)
    grace = seconds_of(args.grace, "--grace") if args.grace else 5.0
    signals: list[dict] = []
    with locked():
        rec = liveness(resolve(args.id))
        if rec["ended_at"] is not None:
            result = stop_object(rec, already_final=True, dry_run=args.dry_run)
            return print_stop(args, result)
        if rec["pending"]:
            if not args.dry_run:
                finalize(rec, "not-started", "canceled", 12, None, "stop", phase="launch")
                save(rec)
            result = stop_object(rec, canceled=True, dry_run=args.dry_run, ended=True)
            if args.dry_run:
                result.update(run_exit_code=12, state="not-started", outcome="not-started")
                result["end_reason"] = "canceled"
            return print_stop(args, result)
        if args.dry_run:
            return print_stop(
                args,
                stop_object(
                    rec,
                    dry_run=True,
                    ended=False,
                    run_exit_code=None,
                    outcome=None,
                    end_reason=None,
                ),
            )
        rec["stop_requested_at"] = stamp()
        save(rec)
        pid, start = rec["wrapper_pid"], rec["wrapper_start"]
    signals.append({"pid": pid, "role": "wrapper", "signal": "SIGTERM"})
    send(pid, signal.SIGTERM)
    deadline = time.monotonic() + grace
    while time.monotonic() < deadline and proc_alive(pid, start):
        time.sleep(0.02)
    killed = False
    if proc_alive(pid, start):
        signals.append({"pid": pid, "role": "wrapper", "signal": "SIGKILL"})
        send(pid, signal.SIGKILL)
        killed = True
        while proc_alive(pid, start):
            time.sleep(0.02)
    with locked():
        rec = load(rec["id"])
        if rec["ended_at"] is None:  # the wrapper could not finalize: stop records it
            finalize(rec, "killed", "stopped", 15, None, "stop")
            rec["recorded_by_stop"] = True
            save(rec)
    result = stop_object(rec, signals=signals, recorded_by_stop=killed and rec["recorded_by_stop"])
    return print_stop(args, result)


def print_stop(args: argparse.Namespace, result: dict) -> int:
    if args.json:
        emit(result)
    return 0


HANDLERS = {
    "start": cmd_start,
    "exec": cmd_exec,
    "status": cmd_status,
    "list": cmd_list,
    "forget": cmd_forget,
    "stop": cmd_stop,
}


def fail(code: int, message: str, as_json: bool, envelope: dict) -> int:
    sys.stderr.write(f"claude-session: error: {message}\n")
    if as_json:
        error = {"code": envelope.pop("code", "failed"), "message": message}
        error.update(envelope)
        emit({"error": error})
    return code


def main(argv: list[str]) -> int:
    as_json = "--json" in argv
    log_line(
        {
            "event": "call",
            "pid": os.getpid(),
            "ppid": os.getppid(),
            "argv": argv,
            "cwd": os.getcwd(),
            "scenario": os.environ.get("FAKE_CS_SCENARIO", "valid"),
            "home": os.environ.get("HOME"),
            "env_names": sorted(os.environ),
            "time": stamp(),
        }
    )
    code = 1
    try:
        if argv[:1] == ["--version"]:
            sys.stdout.write(f"claude-session {VERSION} (fake)\n")
            return 0
        if argv[:1] and argv[0] in UNIMPLEMENTED:
            raise UsageError(f"the fake does not implement {argv[0]}")
        args = build_parser().parse_args(argv)
        code = HANDLERS[args.command](args)
    except UsageError as error:
        code = fail(2, str(error), as_json, {"code": "usage"})
    except Exit as leave:
        code = leave.status
        if leave.message:
            code = fail(leave.status, leave.message, as_json, dict(leave.envelope))
    finally:
        log_line({"event": "exit", "pid": os.getpid(), "code": code, "time": stamp()})
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
