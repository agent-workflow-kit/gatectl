{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gatectl/cli/check.json",
  "title": "gatectl check result",
  "description": "stdout of check on exits 0, 11 and 13, always, whatever --json says. No input text appears here: only declared fields are stored, and they are shown by show. Exits 1 and 2 print the error envelope instead.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "decision_id": {
      "$ref": "../defs.json#/$defs/decision_id",
      "description": "Present exactly when a decision was recorded; absent in state off, in a shadow failure and for not_applicable. A caller reads an absent decision_id as null."
    },
    "policy": {
      "$ref": "../defs.json#/$defs/policy_name"
    },
    "scope": {
      "$ref": "../defs.json#/$defs/scope"
    },
    "state": {
      "$ref": "../defs.json#/$defs/state",
      "description": "The effective state read when the decision was recorded."
    },
    "shadow": {
      "type": "boolean",
      "description": "true only in the shadow state."
    },
    "enforced": {
      "type": "boolean",
      "description": "true only in the enforced state. A caller that enables an automatic action must require enforced true and decision allow."
    },
    "decision": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/decision"
        },
        {
          "type": "null"
        }
      ],
      "description": "The would-be decision; null only in state off."
    },
    "reason": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/reason"
        },
        {
          "type": "null"
        }
      ],
      "description": "null only when decision is null."
    },
    "fingerprint": {
      "$ref": "../defs.json#/$defs/fingerprint"
    },
    "input_sha256": {
      "$ref": "../defs.json#/$defs/sha256",
      "description": "SHA-256 of the canonical JSON of the whole parsed input; present exactly when a decision was recorded."
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/check_entry"
      },
      "description": "Every check in execution order; empty when the state is off, for not_applicable and when the declaration failed."
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/warning"
      },
      "description": "Closed codes: repo_invalid, repo_mismatch, definition_changed, config_problem, output_truncated."
    },
    "error": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/error"
        },
        {
          "type": "null"
        }
      ],
      "description": "A shadow failure after the state was known: the decision could not be recorded."
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy",
    "scope",
    "state",
    "shadow",
    "enforced",
    "decision",
    "reason",
    "fingerprint",
    "checks",
    "warnings",
    "error"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "shadow"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "shadow": {
            "const": true
          },
          "enforced": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "enforced"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "shadow": {
            "const": false
          },
          "enforced": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "off"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "shadow": {
            "const": false
          },
          "enforced": {
            "const": false
          },
          "checks": {
            "maxItems": 0
          },
          "error": {
            "type": "null"
          }
        },
        "not": {
          "required": [
            "decision_id"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "decision_id"
        ]
      },
      "then": {
        "required": [
          "input_sha256"
        ],
        "properties": {
          "decision": {
            "$ref": "../defs.json#/$defs/decision"
          },
          "reason": {
            "enum": [
              "all_passed",
              "check_denied",
              "check_escalated",
              "input_invalid",
              "timeout",
              "budget_exhausted",
              "busy",
              "tool_missing",
              "agent_unreported",
              "artifact_invalid",
              "low_confidence",
              "sandbox_unavailable",
              "check_error"
            ]
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "decision_id"
          ]
        }
      },
      "then": {
        "not": {
          "required": [
            "input_sha256"
          ]
        }
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "decision_id"
          ]
        }
      },
      "then": {
        "oneOf": [
          {
            "properties": {
              "state": {
                "const": "off"
              },
              "decision": {
                "type": "null"
              },
              "reason": {
                "type": "null"
              }
            }
          },
          {
            "properties": {
              "decision": {
                "const": "allow"
              },
              "reason": {
                "const": "not_applicable"
              },
              "checks": {
                "maxItems": 0
              },
              "error": {
                "type": "null"
              }
            }
          },
          {
            "properties": {
              "state": {
                "const": "shadow"
              },
              "decision": {
                "$ref": "../defs.json#/$defs/decision"
              },
              "reason": {
                "enum": [
                  "all_passed",
                  "check_denied",
                  "check_escalated",
                  "input_invalid",
                  "timeout",
                  "budget_exhausted",
                  "busy",
                  "tool_missing",
                  "agent_unreported",
                  "artifact_invalid",
                  "low_confidence",
                  "sandbox_unavailable",
                  "check_error"
                ]
              },
              "error": {
                "$ref": "../defs.json#/$defs/error"
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "reason": {
            "const": "not_applicable"
          }
        },
        "required": [
          "reason"
        ]
      },
      "then": {
        "not": {
          "required": [
            "decision_id"
          ]
        }
      }
    }
  ]
}
