{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gatectl/cli/reconcile.json",
  "title": "gatectl reconcile result",
  "type": "object",
  "properties": {
    "dry_run": {
      "type": "boolean"
    },
    "slots_freed": {
      "type": "integer",
      "minimum": 0
    },
    "sessions_stopped": {
      "type": "integer",
      "minimum": 0
    },
    "sessions_forgotten": {
      "type": "integer",
      "minimum": 0
    },
    "tmp_removed": {
      "type": "integer",
      "minimum": 0
    },
    "overdue": {
      "type": "integer",
      "minimum": 0,
      "description": "Live slot holders past their expires_at; reported, never freed."
    }
  },
  "additionalProperties": false,
  "required": [
    "dry_run",
    "slots_freed",
    "sessions_stopped",
    "sessions_forgotten",
    "tmp_removed",
    "overdue"
  ]
}
